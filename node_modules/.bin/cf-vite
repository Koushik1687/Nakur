#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/proc/cygdrive/d/Nakur/node_modules/.pnpm/@cloudflare+vite-plugin@1.5_3ec3976de9c750ed20cd4270ad0bbe99/node_modules/@cloudflare/vite-plugin/node_modules:/proc/cygdrive/d/Nakur/node_modules/.pnpm/@cloudflare+vite-plugin@1.5_3ec3976de9c750ed20cd4270ad0bbe99/node_modules:/proc/cygdrive/d/Nakur/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/proc/cygdrive/d/Nakur/node_modules/.pnpm/@cloudflare+vite-plugin@1.5_3ec3976de9c750ed20cd4270ad0bbe99/node_modules/@cloudflare/vite-plugin/node_modules:/proc/cygdrive/d/Nakur/node_modules/.pnpm/@cloudflare+vite-plugin@1.5_3ec3976de9c750ed20cd4270ad0bbe99/node_modules:/proc/cygdrive/d/Nakur/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.pnpm/@cloudflare+vite-plugin@1.5_3ec3976de9c750ed20cd4270ad0bbe99/node_modules/@cloudflare/vite-plugin/bin/cf-vite" "$@"
else
  exec node  "$basedir/../.pnpm/@cloudflare+vite-plugin@1.5_3ec3976de9c750ed20cd4270ad0bbe99/node_modules/@cloudflare/vite-plugin/bin/cf-vite" "$@"
fi
