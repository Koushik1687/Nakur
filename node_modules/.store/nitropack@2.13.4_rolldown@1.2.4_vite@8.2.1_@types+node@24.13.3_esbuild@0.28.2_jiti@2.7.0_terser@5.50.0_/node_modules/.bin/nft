#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

export NODE_PATH="$basedir/..;$basedir/../../../node_modules"
if [ -x "$basedir/node" ]; then
  exec "$basedir/node" "$basedir/../../../@vercel+nft@1.10.2_rollup@4.62.4/node_modules/@vercel/nft/out/cli.js" "$@"
else
  exec node "$basedir/../../../@vercel+nft@1.10.2_rollup@4.62.4/node_modules/@vercel/nft/out/cli.js" "$@"
fi
