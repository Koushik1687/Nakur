#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

export NODE_PATH="$basedir/..;$basedir/../../../node_modules"
if [ -x "$basedir/node" ]; then
  exec "$basedir/node" "$basedir/../../../rollup-plugin-visualizer@7.1.1_rolldown@1.2.4_rollup@4.62.4/node_modules/rollup-plugin-visualizer/dist/bin/cli.js" "$@"
else
  exec node "$basedir/../../../rollup-plugin-visualizer@7.1.1_rolldown@1.2.4_rollup@4.62.4/node_modules/rollup-plugin-visualizer/dist/bin/cli.js" "$@"
fi
