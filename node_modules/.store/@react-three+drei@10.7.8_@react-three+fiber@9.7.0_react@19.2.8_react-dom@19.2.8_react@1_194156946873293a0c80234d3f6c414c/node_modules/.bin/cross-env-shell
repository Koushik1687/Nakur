#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

export NODE_PATH="$basedir/..;$basedir/../../../node_modules"
if [ -x "$basedir/node" ]; then
  exec "$basedir/node" "$basedir/../../../cross-env@7.0.3/node_modules/cross-env/src/bin/cross-env-shell.js" "$@"
else
  exec node "$basedir/../../../cross-env@7.0.3/node_modules/cross-env/src/bin/cross-env-shell.js" "$@"
fi
