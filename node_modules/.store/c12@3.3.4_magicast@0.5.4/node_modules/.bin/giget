#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

export NODE_PATH="$basedir/..;$basedir/../../../node_modules"
if [ -x "$basedir/node" ]; then
  exec "$basedir/node" "$basedir/../../../giget@3.3.1/node_modules/giget/dist/cli.mjs" "$@"
else
  exec node "$basedir/../../../giget@3.3.1/node_modules/giget/dist/cli.mjs" "$@"
fi
