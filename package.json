{
  "name": "nakur",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Girish Nakur — React + Vite frontend with a Nitro + h3 backend",
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "nitro dev --port 3001",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc -b && vite build",
    "build:api": "nitro build",
    "build:vercel": "npm run build:web && npm run build:api -- --preset vercel && mkdir -p .vercel/output/static && cp -r dist/* .vercel/output/static/ && node scripts/vercel-spa-fallback.mjs",
    "build:netlify": "nitro build --preset netlify",
    "build:cloudflare": "nitro build --preset cloudflare-pages",
    "build:aws": "nitro build --preset aws-lambda",
    "preview": "bun run build && wrangler dev",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.1.2",
    "nitropack": "^2.13.4",
    "oxlint": "^1.75.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0",
    "wrangler": "^4.123.0"
  },
  "pnpm": {
    "overrides": {
      "string-width-cjs": "npm:string-width@4.2.3"
    }
  },
  "overrides": {
    "string-width-cjs": "npm:string-width@4.2.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  }
}
